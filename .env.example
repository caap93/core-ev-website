# Public URL of the site — used to build invite / password-reset links in emails.
APP_URL=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgres://core:core@localhost:5432/core_ev

# Admin account created automatically on first start (if it does not exist yet).
# Changing these later does NOT change an existing account's password.
ADMIN_EMAIL=evcore@ugent.be
ADMIN_NAME="Dr. Cláudio Pinheiro"
ADMIN_PASSWORD=change-me

# Where uploaded project files are stored on disk (mount a persistent volume here).
UPLOAD_DIR=./uploads

# Outgoing email (invites, password resets, contact messages).
# If SMTP_HOST is empty, emails are printed to the server log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CORE EV <evcore@ugent.be>"
# Inbox that receives contact-form and portal messages.
FACILITY_INBOX=evcore@ugent.be
